# Runtime API connects as app_user (non-owner, RLS enforced). Migrations connect as
# the superuser/owner (marketpilot) since DDL and role/grant management need it.
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_password@localhost:5432/marketpilot
DATABASE_URL_DIRECT=postgresql+psycopg://marketpilot:marketpilot@localhost:5432/marketpilot
# Password the "app_user role" migration sets for the app_user role. Change this
# (and re-run that migration, or ALTER ROLE by hand) for any non-local environment.
APP_USER_DB_PASSWORD=app_user_dev_password
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated Fernet keys; first encrypts, all decrypt (rotation). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=

# Model-provider base URLs on loopback/private networks (e.g. a local Ollama) are refused
# unless this is true. Leave it false on a shared or cloud deployment; link-local and cloud
# metadata addresses are always refused.
ALLOW_PRIVATE_BASE_URLS=false
